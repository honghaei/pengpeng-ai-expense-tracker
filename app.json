        "foregroundImage": "./assets/branding/pengpeng-app-icon.png",
        "backgroundColor": "#03142F"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.charleslat.smartexpensetracker"
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "extra": {},

    "description": "Pengpeng — The Smart AI Expense Tracker for personalized budgeting, wallets, bills, goals, reports, and spending insights.",

    "scheme": "smartexpensetracker"
  }
