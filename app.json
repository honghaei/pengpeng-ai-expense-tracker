{
  "expo": {
    "name": "Pengpeng",
    "slug": "smart-expense-tracker",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/branding/pengpeng-app-icon.png",

    "userInterfaceStyle": "dark",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/branding/pengpeng-avatar.png",
      "resizeMode": "contain",
      "backgroundColor": "#03142F"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.charleslat.smartexpensetracker"
    },

    "android": {
